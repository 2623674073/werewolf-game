            "title": "Shoot Reason"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": ["player", "shoot"],
        "title": "HunterActionPayload"
      },
      "IdentityPayload": {
        "properties": {
          "player": {
            "type": "string",
            "title": "Player"
