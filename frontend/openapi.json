  "components": {
    "schemas": {
      "CreateGameRequest": {
        "properties": {
          "player_count": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 6.0,
            "title": "Player Count"
          }
        },
        "type": "object",
        "required": ["player_count"],
        "title": "CreateGameRequest"
      },
      "DayVotePayload": {
        "properties": {
          "player": {
            "type": "string",
            "title": "Player"
          },
          "vote": {
            "type": "string",
            "title": "Vote"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "suspicion_level": {
            "type": "integer",
            "title": "Suspicion Level"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": ["player", "vote", "reason", "suspicion_level"],
        "title": "DayVotePayload"
      },
      "DiscussionStartedPayload": {
        "properties": {
          "discussion_kind": {
            "type": "string",
            "title": "Discussion Kind"
          },
          "round": {
            "type": "integer",
            "title": "Round"
          },
          "participants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Participants"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": ["discussion_kind", "round", "participants"],
        "title": "DiscussionStartedPayload"
      },
      "ErrorPayload": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "ErrorPayload"
      },
      "EventResponse": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "type": {
            "type": "string",
            "enum": [
              "identity_assigned",
              "game_started",
              "night_started",
              "day_started",
              "discussion_started",
              "speaker_turn_started",
              "speech",
              "speech_moderated",
              "werewolf_vote",
              "seer_result",
              "witch_action",
              "day_vote",
              "hunter_action",
              "night_result",
              "vote_result",
              "roles_revealed",
              "game_finished",
              "game_cancelled",
              "game_interrupted",
              "game_failed"
            ],
            "title": "Type"
          },
          "phase": {
            "type": "string",
            "enum": ["setup", "night", "day", "finished"],
            "title": "Phase"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private", "internal"],
            "title": "Visibility"
          },
          "recipients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recipients"
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IdentityPayload"
              },
              {
                "$ref": "#/components/schemas/GameStartedPayload"
              },
              {
                "$ref": "#/components/schemas/PhaseStartedPayload"
              },
              {
                "$ref": "#/components/schemas/DiscussionStartedPayload"
              },
              {
                "$ref": "#/components/schemas/SpeakerPayload"
              },
              {
                "$ref": "#/components/schemas/SpeechPayload"
              },
              {
                "$ref": "#/components/schemas/ModeratedSpeechPayload"
              },
              {
                "$ref": "#/components/schemas/WerewolfVotePayload"
              },
              {
                "$ref": "#/components/schemas/SeerResultPayload"
              },
              {
                "$ref": "#/components/schemas/WitchActionPayload"
              },
              {
                "$ref": "#/components/schemas/DayVotePayload"
              },
              {
                "$ref": "#/components/schemas/HunterActionPayload"
              },
              {
                "$ref": "#/components/schemas/NightResultPayload"
              },
              {
                "$ref": "#/components/schemas/VoteResultPayload"
              },
              {
                "$ref": "#/components/schemas/RolesRevealedPayload"
              },
              {
                "$ref": "#/components/schemas/FinishedPayload"
              },
              {
                "$ref": "#/components/schemas/ErrorPayload"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "title": "Payload"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "seq",
          "type",
          "phase",
          "visibility",
          "recipients",
          "payload",
          "created_at"
        ],
        "title": "EventResponse"
      },
      "FinishedPayload": {
        "properties": {
          "winner": {
            "type": "string",
            "title": "Winner"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": ["winner"],
        "title": "FinishedPayload"
      },
      "GameResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "player_count": {
            "type": "integer",
            "title": "Player Count"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "running",
              "completed",
              "draw",
              "cancelled",
              "interrupted",
              "failed"
            ],
            "title": "Status"
          },
          "phase": {
            "type": "string",
            "enum": ["setup", "night", "day", "finished"],
            "title": "Phase"
          },
          "round_number": {
            "type": "integer",
            "title": "Round Number"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerResponse"
            },
            "type": "array",
            "title": "Players"
          },
          "winner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "player_count",
          "status",
          "phase",
          "round_number",
          "players",
          "created_at"
        ],
        "title": "GameResponse"
      },
      "GameReviewResponse": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "completed", "failed"],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameReviewResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": ["game_id", "status", "created_at"],
        "title": "GameReviewResponse"
      },
      "GameReviewResult": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "overview": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Overview"
          },
          "turning_points": {
            "items": {
              "$ref": "#/components/schemas/TurningPoint"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 2,
            "title": "Turning Points"
          },
          "winning_factors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Winning Factors"
          },
          "player_reviews": {
            "items": {
              "$ref": "#/components/schemas/PlayerReview"
            },
            "type": "array",
            "minItems": 1,
            "title": "Player Reviews"
          },
          "mvp": {
            "type": "string",
            "title": "Mvp"
          },
          "closing_comment": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Closing Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "overview",
          "turning_points",
          "winning_factors",
          "player_reviews",
          "mvp",
          "closing_comment"
        ],
        "title": "GameReviewResult"
      },
      "GameStartedPayload": {
        "properties": {
          "players": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": ["players"],
        "title": "GameStartedPayload"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HunterActionPayload": {
        "properties": {
          "player": {
            "type": "string",
